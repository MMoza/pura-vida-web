---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/footer/Footer.astro";
import Header from "../components/header/Header.astro";
---

<BaseLayout>

    <Header />

  <main class="min-h-screen flex flex-col">

    <!-- contenido -->
    <div class="flex-1 flex flex-col items-center justify-center text-center px-6 gap-6">

      <h1 class="text-3xl md:text-4xl font-display tracking-wide">
        Próximamente...
      </h1>

      <p class="text-gray-600 max-w-md">
        Estamos preparando esta sección. Muy pronto podrás descubrir todo lo que tenemos para ti.
      </p>

      <a href="/" class="hero-back group">
        Volver al inicio
        <span class="hero-arrow">→</span>
      </a>

    </div>

    <Footer />

  </main>

</BaseLayout>

<style>

.hero-back{
  display:inline-flex;
  align-items:center;
  gap:.35rem;

  font-weight:600;
  text-decoration:none;
  color:#111;

  transition:opacity .2s ease;
}

.hero-back:hover{
  opacity:.75;
}

.hero-arrow{
  display:inline-block;
  transition:transform .2s ease;
}

.hero-back:hover .hero-arrow{
  transform:translateX(6px);
}

</style>