---
const {
  name,
  description = "",
  price = "",
  glassPrice = "",
  image = "",
  badge = "",
} = Astro.props;

const normalizedGlassPrice = String(glassPrice || "").replace(" €", "").replace("€", "").trim();
const [glassEuros, glassDecimalsRaw = ""] = normalizedGlassPrice.split(",");
const glassDecimals = glassDecimalsRaw ? `,${glassDecimalsRaw}` : "";
---

<article class="drink-card" role="listitem">
  {
    image && (
      <div class="drink-card__media">
        <img src={image} alt={name} class="drink-card__image" />
        <div class="drink-card__media-overlay"></div>
        {
          glassPrice && (
            <span class="drink-card__glass-price">
              <span class="drink-card__glass-label">Copa</span>
              <span class="drink-card__glass-value">
                <span class="drink-card__glass-euros">{glassEuros}</span>
                {
                  glassDecimals && (
                    <span class="drink-card__glass-decimals">{glassDecimals}</span>
                  )
                }
                <span class="drink-card__glass-currency">€</span>
              </span>
            </span>
          )
        }
      </div>
    )
  }

  <div class="drink-card__body">
    <div class="drink-card__top">
      <div>
        {badge && <p class="drink-card__badge">{badge}</p>}
        <h3 class="drink-card__title">{name}</h3>
      </div>

      {price && <span class="drink-card__price">{price}</span>}
    </div>

    {description && <p class="drink-card__description">{description}</p>}
  </div>
</article>

<style>
  .drink-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 1.5rem;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 14px 36px rgba(35, 48, 39, 0.08);
    backdrop-filter: blur(10px);
    scroll-snap-align: start;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .drink-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.95);
    box-shadow: 0 18px 44px rgba(35, 48, 39, 0.12);
  }

  .drink-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background:
      radial-gradient(circle at 25% 25%, rgba(61, 143, 105, 0.12), transparent 35%),
      linear-gradient(180deg, rgba(131, 131, 131, 0.25), rgba(255, 255, 255, 0));
  }

  .drink-card__image {
    display: block;
    position: relative;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .drink-card__media-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(circle at 25% 25%, rgba(61, 143, 105, 0.12), transparent 35%),
      linear-gradient(180deg, rgba(131, 131, 131, 0.25), rgba(255, 255, 255, 0));
  }

  .drink-card__glass-price {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 2;
    border-radius: 999px;
    background:
      radial-gradient(circle at 30% 28%, rgba(172, 163, 168, 0.45), transparent 56%),
      linear-gradient(180deg, rgba(227, 174, 190, 0.96), rgba(253, 205, 221, 0.94));
    min-width: 4.55rem;
    padding: 0.44rem 0.72rem 0.5rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.14rem;
    color: #621a3e;
    box-shadow: 0 12px 26px rgba(127, 29, 78, 0.2);
    backdrop-filter: blur(8px);
    transform: rotate(-7deg);
  }

  .drink-card__glass-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 5px;
  }

  .drink-card__glass-value {
    display: inline-flex;
    align-items: flex-start;
    line-height: 1;
  }

  .drink-card__glass-euros {
    font-size: 1.28rem;
    font-weight: 800;
    line-height: 0.95;
  }

  .drink-card__glass-decimals {
    margin-left: 0.02rem;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
  }

  .drink-card__glass-currency {
    margin-left: 0.08rem;
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1;
  }

  .drink-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem 1rem 1.1rem;
  }

  .drink-card__top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .drink-card__badge {
    margin-bottom: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(61, 143, 105, 0.85);
  }

  .drink-card__title {
    font-size: 1.1rem;
    line-height: 1.1;
    color: #111827;
  }

  .drink-card__price {
    flex: none;
    border-radius: 999px;
    background: rgba(61, 143, 105, 0.1);
    padding: 0.35rem 0.7rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #1f4d39;
  }

  .drink-card__description {
    margin-top: 0.9rem;
    font-size: 0.94rem;
    line-height: 1.65;
    color: #4b5563;
  }
</style>
