---
import MenuItem from "./MenuItem.astro";

const { category, items } = Astro.props;
---

<details class="mb-6 bg-white/40 rounded-xl p-4 backdrop-blur group" open>

<summary class="menu-summary sticky top-[138px] z-30 flex items-center justify-between cursor-pointer py-3 border-b border-neutral-400 bg-white/80 backdrop-blur">

    <h3 class="text-xl font-semibold">
      {category}
    </h3>

    <span class="chevron transition-transform duration-200 group-open:rotate-180">

      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4 opacity-60 group-hover:opacity-100"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
      </svg>

    </span>

  </summary>

  <div class="space-y-4 pt-4">

    {items.map(item => (
      <MenuItem item={item} />
    ))}

  </div>

</details>

<style>
  .menu-summary {
  padding-top: 10px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
}
</style>