---
const { title, subtitle = "", actionHref = "", actionLabel = "" } = Astro.props;
---

<section class="drink-shelf">
  <div class="drink-shelf__head">
    <div>
      <h2 class="drink-shelf__title">{title}</h2>
      {subtitle && <p class="drink-shelf__subtitle">{subtitle}</p>}
    </div>

    {
      actionHref && actionLabel && (
        <a href={actionHref} class="drink-shelf__link">
          <span>{actionLabel}</span>
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>

  <div class="drink-shelf__track" role="list">
    <slot />
  </div>
</section>

<style>
  .drink-shelf {
    margin-top: 3rem;
  }

  .drink-shelf__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .drink-shelf__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(61, 143, 105, 0.85);
  }

  .drink-shelf__title {
    margin-top: 0.35rem;
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    line-height: 1;
    color: #111827;
  }

  .drink-shelf__subtitle {
    margin-top: 0.5rem;
    max-width: 40ch;
    font-size: 0.98rem;
    color: #4b5563;
  }

  .drink-shelf__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
    transition: color 0.2s ease;
  }

  .drink-shelf__link span:last-child {
    transition: transform 0.2s ease;
  }

  .drink-shelf__link:hover {
    color: #111827;
  }

  .drink-shelf__link:hover span:last-child {
    transform: translateX(4px);
  }

  .drink-shelf__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(17.5rem, 22rem);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-bottom: 0.5rem;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .drink-shelf__track::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 640px) {
    .drink-shelf__head {
      align-items: start;
      flex-direction: column;
    }

    .drink-shelf__track {
      grid-auto-columns: minmax(15.5rem, 80vw);
    }
  }
</style>
