---
import AllergenIcon from "../AllergenIcon.astro"
import AllergenTooltip from "../AllergenTooltip.astro"

const { item } = Astro.props;
const { type } = Astro.props

---


<div class={`menu-item reveal
  ${item.novedad ? "menu-item-new" : ""} 
  ${item.oferta ? "menu-item-sale" : ""}
`}>
  <div class="menu-info">
    <div class="menu-header">
    <h4 class={`menu-name ${item.novedad ? "menu-name-new" : ""}`}>
      {item.nombre}

      {item.novedad && <span class="menu-badge">NEW</span>}
      {item.oferta && <span class="menu-badge-sale">OFERTA</span>}
      {
        item.localProduct && (
          <AllergenTooltip label="Producto fresco 100% Extremeño">
            <span class="menu-badge-extrem" aria-label="Producto fresco 100% Extremeño"></span>
          </AllergenTooltip>
        )
      }
    </h4>
    </div>

    {item.descripcion && <p class="menu-desc">{item.descripcion}</p>}

    {
      item.alergenos?.length > 0 && (
        <div class="menu-alergenos">

          {item.alergenos.map((a) => (

            <AllergenTooltip label={a}>
              <AllergenIcon type={a} />
            </AllergenTooltip>

          ))}

        </div>
      )
    }
  </div>

  <div class="menu-price">
    {
      item.oferta && item.precio_anterior && (
        <span class="price-old">{item.precio_anterior}€</span>
      )
    }

    <span class="price-current">
      {item.precio}€
    </span>
  </div>
</div>

<style>
  .menu-item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;

    border-left: 3px solid #404040;
    padding-left: 0.6rem;
    border-bottom: solid 1px #404040;
    border-radius: 8px;

    padding-bottom: 0.9rem;
    padding-right: 10px;

    transition: all .2s ease;
  }

  .menu-item:hover {

    transform: translateX(4px);
    background: rgba(0,0,0,0.02);
  }

  .menu-name {
    font-weight: 600;
  }

  .menu-desc {
    font-size: 0.9rem;
    color: #71717a;
  }

  .menu-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .price-old {
    font-size: 0.8rem;
    text-decoration: line-through;
    color: #a1a1aa;
  }

  .price-current {
    font-weight: 700;
  }

  .menu-item-sale .price-current {
    color: #8a5c0b;
  }

  .menu-badge {
    margin-left: 0.4rem;

    font-size: 0.65rem;
    font-weight: 600;

    background: #2fbb7a;
    color: white;

    padding: 0.18rem 0.4rem;
    border-radius: 6px;

    display: inline-flex;
    align-items: center;

    animation: badgePulse 2.2s ease-in-out infinite;
  }

  .menu-alergenos {
    margin-top: .3rem;
    display: flex;
    gap: .35rem;
    align-items: center;
  }

  .menu-item-new {
    background: rgba(47, 187, 122, 0.05);
    border-radius: 8px;
    padding: 0.6rem 0.6rem 0.9rem 0.6rem;
    border-left: 3px solid #2fbb7a;
    padding-left: 0.6rem;
    border-bottom: solid 1px #2fbb7a;
  }

  .menu-name-new {
    color: #2fbb7a;
  }

  .menu-item-sale {
  background: rgba(255, 180, 0, 0.06);
  border-left: 3px solid #f59e0b;
  border-bottom: solid 1px #f59e0b;
  }

  .menu-badge-sale {
    margin-left: .4rem;

    font-size: .65rem;
    font-weight: 600;

    background: #f59e0b;
    color: white;

    padding: .18rem .4rem;
    border-radius: 6px;
  }

  .menu-badge-extrem {
    margin-left: 0.4rem;
    width: 0.9rem;
    height: 0.9rem;
    flex: none;
    background: linear-gradient(
      180deg,
      #167245 0%,
      #167245 33.33%,
      #f7f7f5 33.33%,
      #f7f7f5 66.66%,
      #1a1a1a 66.66%,
      #1a1a1a 100%
    );
    border-radius: 999px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  }

  @keyframes badgePulse {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(61, 143, 105, 0.4);
    }

    50% {
      transform: scale(1.06);
      box-shadow: 0 0 0 6px rgba(61, 143, 105, 0);
    }

    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(61, 143, 105, 0);
    }
  }
</style>
