---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/header/Header.astro"
import Hero from "../components/hero/Hero.astro";
import Menu from "../components/menu/Menu.astro";
import Reservation from "../components/reservation/Reservation.astro";
import Location from "../components/location/Location.astro";
import Footer from "../components/footer/Footer.astro";
import Drinks from "../components/bodega/Drinks.astro";
---

<BaseLayout>

  <Header />

  <Hero id="inicio" />

  <Menu id="carta" />

  <Drinks id="bebidas" />

  <Reservation id="reservas" />

  <Location id="ubicacion" />

  <Footer />

</BaseLayout>