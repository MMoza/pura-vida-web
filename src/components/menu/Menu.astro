---
import { getMenu } from "../../services/menuService";
import { groupMenuByCategory } from "../../utils/groupMenu";
import MenuCategory from "./MenuCategory.astro";

const menu = await getMenu();

const grouped = groupMenuByCategory(menu);

const categories = Object.keys(grouped);
---

<section id="carta" class="section section-bg max-w-3xl mx-auto px-4 py-12">

  <div class="menu-indicator"></div>

    <!-- Header -->
  <div class="text-left mb-10">

    <h2 class="text-3xl md:text-4xl font-display font-semibold text-gray-900">
      Nuestra carta
    </h2>

    <p class="text-gray-600 mt-2 text-sm md:text-base">
      Sabores pensados para compartir buenos momentos
    </p>

  </div>

  <!-- Tabs -->

  <div class="menu-tabs">
    {
      categories.map((cat) => (
        <a
          href={`#cat-${cat.toLowerCase().replace(/\s+/g, "-")}`}
          class="menu-tab"
        >
          {cat}
        </a>
      ))
    }
  </div>

  <!-- Categorías -->

  <div class="space-y-12 mt-10">
    {
      categories.map((cat) => (
        <div
          id={`cat-${cat.toLowerCase().replace(/\s+/g, "-")}`}
          class="menu-section"
        >
          <MenuCategory category={cat} items={grouped[cat]} />
        </div>
      ))
    }
  </div>
</section>

<script>
const sections = [...document.querySelectorAll(".menu-section")]
const tabs = [...document.querySelectorAll(".menu-tab")]
const tabsContainer = document.querySelector(".menu-tabs")

const HEADER_OFFSET = 120
let activeId = null

function setActiveTab(id){

  activeId = id

  let activeTab = null

  tabs.forEach(tab=>{
    const isActive = tab.getAttribute("href") === `#${id}`
    tab.classList.toggle("active", isActive)
    if(isActive) activeTab = tab
  })

  if(!activeTab) return

  const tabRect = activeTab.getBoundingClientRect()
  const containerRect = tabsContainer.getBoundingClientRect()

  if(tabRect.left < containerRect.left || tabRect.right > containerRect.right){
    tabsContainer.scrollTo({
      left: activeTab.offsetLeft - tabsContainer.offsetWidth/2 + activeTab.offsetWidth/2,
      behavior:"smooth"
    })
  }
}

function updateActiveTab(){

  let current = sections[0]

  sections.forEach(section=>{
    const rect = section.getBoundingClientRect()
    if(rect.top <= HEADER_OFFSET){
      current = section
    }
  })

  if(current && current.id !== activeId){
    setActiveTab(current.id)
  }

}

tabs.forEach(tab=>{

  tab.addEventListener("click", e=>{

    e.preventDefault()

    const id = tab.getAttribute("href").replace("#","")
    const target = document.getElementById(id)

    if(!target) return

    const y =
      target.getBoundingClientRect().top +
      window.pageYOffset -
      HEADER_OFFSET

    window.scrollTo({
      top: y,
      behavior:"smooth"
    })

    setActiveTab(id)

  })

})

let ticking=false

window.addEventListener("scroll",()=>{

  if(!ticking){
    requestAnimationFrame(()=>{
      updateActiveTab()
      ticking=false
    })
    ticking=true
  }

})

updateActiveTab()
</script>

<style>
  .menu-tabs {

    position: sticky;
    top: 88px;
    z-index: 40;

    display: flex;
    gap: .5rem;

    overflow-x: auto;

    padding: .6rem .4rem;

    backdrop-filter: blur(10px);
    background: rgba(255,255,255,0.85);

    border-radius: 10px 10px 0 0;

    scrollbar-width: none;
  }

  .menu-indicator {

    position: absolute;

    height: 3px;
    bottom: 4px;

    background: #3d8f69;

    border-radius: 3px;

    transition:
      transform .25s ease,
      width .25s ease;
  }

  .menu-tab {
    flex: none;

    font-size: 0.9rem;
    font-weight: 500;

    padding: 0.35rem 0.9rem;

    border-radius: 999px;

    background: rgba(0, 0, 0, 0.05);

    white-space: nowrap;

    transition: all 0.2s ease;
    scroll-behavior: smooth;
    scroll-margin-inline: 16px;
  }

  @media (hover: hover) {
    .menu-tab:hover {
      background: #3d8f69;
      color: white;
    }
  }

  .menu-tabs::-webkit-scrollbar {
    display: none;
  }

  .menu-tab.active {
    background: #3d8f69;
    color: white;
    transform: scale(.96);

    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }
</style>
