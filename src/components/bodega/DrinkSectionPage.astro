---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../header/Header.astro";
import Footer from "../footer/Footer.astro";
import DrinkShelf from "./DrinkShelf.astro";
import DrinkShelfCard from "./DrinkShelfCard.astro";

const { section, shelves = [] } = Astro.props;
---

<BaseLayout title={`${section.title} | Pura Vida`}>
  <Header />

  <main class="min-h-screen">
    <section class="section section-bg mx-auto max-w-5xl px-4 py-12 md:px-6">
      <a
        href="/#drinks"
        class="inline-flex items-center gap-2 text-sm font-medium text-gray-700 transition-colors duration-200 hover:text-gray-950"
      >
        <span aria-hidden="true">←</span>
        Volver a bebidas
      </a>

      <div class="mt-6">
        <h1 class="mt-3 text-4xl font-display text-gray-950 md:text-5xl">
          {section.title}
        </h1>
        <p class="mt-3 max-w-[42ch] text-base leading-7 text-gray-600">
          {section.description}
        </p>
      </div>

      {shelves.map((shelf) => (
        <DrinkShelf
          title={shelf.title}
          subtitle={shelf.subtitle}
          actionHref={shelf.actionHref}
          actionLabel={shelf.actionLabel}
        >
          {shelf.items.map((item) => (
            <DrinkShelfCard {...item} />
          ))}
        </DrinkShelf>
      ))}
    </section>
  </main>

  <Footer />
</BaseLayout>
